<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="NoteraDesktopShortcutComponent" Guid="*">
          <Shortcut Id="NoteraDesktopShortcut"
                    Name="Notera"
                    Description="本地优先的乐谱阅读器"
                    Target="[INSTALL_ROOT]bin\Notera.exe"
                    WorkingDirectory="INSTALL_ROOT" />
          <RegistryValue Root="HKCU"
                         Key="Software\Notera\Notera"
                         Name="DesktopShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </DirectoryRef>
  </Fragment>
</Wix>
